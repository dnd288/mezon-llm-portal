# Mezon LLM Portal — Environment Variables
# Copy this file to .env.local and fill in the values.

# ──────────────────────────────────────────────
# Mezon OAuth 2.0
# ──────────────────────────────────────────────
MEZON_CLIENT_ID=
MEZON_CLIENT_SECRET=
MEZON_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ──────────────────────────────────────────────
# Mezon OAuth 2.0 Endpoints
# ──────────────────────────────────────────────
MEZON_AUTH_URL=https://oauth2.mezon.ai/oauth2/auth
MEZON_TOKEN_URL=https://oauth2.mezon.ai/oauth2/token
MEZON_USERINFO_URL=https://oauth2.mezon.ai/userinfo

# ──────────────────────────────────────────────
# New-API Backend (mezon-llm)
# ──────────────────────────────────────────────
NEW_API_BASE_URL=https://llm.mrdnd.dev
NEW_API_ADMIN_TOKEN=

# ──────────────────────────────────────────────
# Session / JWT
# ──────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
SESSION_MAX_AGE=86400

# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Mezon LLM
